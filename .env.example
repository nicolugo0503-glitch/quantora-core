# Quantora environment example

# Runtime
PORT=8010
QUANTORA_ALLOW_DEMO_AUTOLOGIN=false
QUANTORA_PASSWORD_SALT=change-this-salt-in-real-deployments
QUANTORA_DEMO_ADMIN_PASSWORD=change-me-immediately

# Alpaca
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Compatibility aliases if used by deployment
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets
# Live provider activation
QUANTORA_PAYMENT_PROVIDER=stripe_simulated
QUANTORA_PAYMENT_WEBHOOK_SECRET=quantora-dev-webhook-secret

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Dwolla
DWOLLA_KEY=
DWOLLA_SECRET=
DWOLLA_WEBHOOK_SECRET=
