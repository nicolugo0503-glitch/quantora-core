      "method": "POST",
      "path": "/api/onboarding/create"
    },
    {
      "method": "POST",
      "path": "/api/onboarding/status"
    },
    {
      "method": "POST",
      "path": "/api/subscription/request"
    },
    {
      "method": "POST",
      "path": "/api/subscription/approve"
    },
    {
      "method": "POST",
      "path": "/api/subscription/reject"
    },
