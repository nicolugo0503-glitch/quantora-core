  "event_types": [
    "deposit",
    "withdrawal",
    "credit",
    "debit",
    "reserve_cash",
    "release_reserved"
  ],
  "core_outputs": [
    "available_cash",
    "reserved_cash",
    "total_cash",
    "ledger_rows"
  ]
