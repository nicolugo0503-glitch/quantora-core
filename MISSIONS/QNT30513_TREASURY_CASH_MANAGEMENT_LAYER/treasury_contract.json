{
  "endpoints": [
    {
      "method": "POST",
      "path": "/api/treasury/cash-event"
    },
    {
      "method": "POST",
      "path": "/api/treasury/reserve"
    },
    {
      "method": "POST",
      "path": "/api/treasury/release"
    },
    {
      "method": "GET",
      "path": "/api/treasury/summary"
    },
    {
      "method": "GET",
      "path": "/api/treasury/ledger"
    }
